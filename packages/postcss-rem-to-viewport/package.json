{
  "name": "postcss-rem-to-viewport",
  "type": "module",
  "version": "2.0.6",
  "description": "Convert rem units to viewport units using PostCSS.",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/postcss-plugins.git",
    "directory": "packages/postcss-rem-to-viewport"
  },
  "bugs": {
    "url": "https://github.com/icelib/postcss-plugins/issues"
  },
  "keywords": [
    "viewport",
    "postcss",
    "postcss-plugin",
    "postcss-rem",
    "rem-to-viewport",
    "responsive",
    "css",
    "rem",
    "vw"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tsd": "pnpm run build && tsd --typings dist/index.d.mts",
    "test:dev": "vitest",
    "bench": "vitest bench",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "postcss": "^8"
  },
  "dependencies": {
    "postcss-plugin-shared": "workspace:*",
    "postcss-rule-unit-converter": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.require.d.cts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.require.cjs"
      }
    },
    "main": "./dist/index.require.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "paths": {
        "postcss-plugin-shared": [
          "../postcss-plugin-shared/dist/index.d.mts"
        ],
        "postcss-rule-unit-converter": [
          "../postcss-rule-unit-converter/dist/index.d.mts"
        ]
      }
    }
  }
}
