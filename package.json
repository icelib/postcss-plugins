{
  "name": "monorepo-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "author": "ice breaker <1324318532@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/postcss-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/icelib/postcss-plugins/issues"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "docs:dev": "pnpm --filter @postcss-plugins/website dev",
    "docs:build": "pnpm --filter @postcss-plugins/website build",
    "docs:preview": "pnpm --filter @postcss-plugins/website preview",
    "deploy:docs": "pnpm docs:build && pnpm exec wrangler deploy --config wrangler.jsonc",
    "test": "vitest run --coverage.enabled",
    "test:dev": "vitest",
    "bench": "node scripts/bench/generate-benchmarks.mjs",
    "bench:baseline": "node scripts/bench/generate-benchmarks.mjs",
    "bench:report": "node scripts/bench/generate-benchmarks.mjs",
    "check:cjs": "node scripts/check-cjs-plugins.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "tsd": "turbo run tsd",
    "release": "repo release stable prepare",
    "publish-packages": "repo release stable publish",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "commit",
    "script:init": "repo workspace init",
    "script:clean": "repo workspace clean",
    "script:mirror": "repo env mirror",
    "commitlint": "commitlint --edit",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@icebreakers/commitlint-config": "4.1.1",
    "@icebreakers/eslint-config": "8.0.2",
    "@icebreakers/stylelint-config": "5.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/get-value": "^3.0.5",
    "@types/klaw": "^3.0.7",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/semver": "^7.8.0",
    "@types/set-value": "^4.0.3",
    "@vitest/coverage-v8": "~5.0.1",
    "ci-info": "^4.4.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "cross-env": "^10.1.0",
    "defu": "^6.1.7",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.11.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "get-value": "^4.1.0",
    "husky": "^9.1.7",
    "klaw": "^4.1.0",
    "lint-staged": "^17.5.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "micromatch": "^4.0.8",
    "only-allow": "^1.2.2",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.3",
    "postcss": "^8.5.28",
    "postcss-plugin-shared": "workspace:^",
    "postcss-pxtorem": "^6.1.0",
    "repoctl": "5.5.5",
    "rimraf": "^6.1.3",
    "set-value": "^4.1.0",
    "stylelint": "^17.15.0",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.33.0",
    "tsdown": "0.23.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "~5.0.1",
    "wrangler": "^4.136.3",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
